FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV SHMTU_MODEL_DIR=/app/models
ENV SHMTU_HTTP_PORT=21600
ENV SHMTU_TCP_PORT=21601
ENV SHMTU_USE_GPU=1
ENV SHMTU_WORKERS=0
ENV SHMTU_QUEUE_CAPACITY=0
ENV SHMTU_NCNN_THREADS=0
ENV SHMTU_MODEL_VERSION=v2

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
        libdrogon1t64 \
        libtrantor1 \
        libopencv-core406t64 \
        libopencv-imgproc406t64 \
        libopencv-imgcodecs406t64 \
        libgoogle-glog0v6t64 \
        libjsoncpp25 \
        libyaml-cpp0.8 \
        libssl3t64 \
        libcurl4t64 \
        libbrotli1 \
        libhiredis1.1.0 \
        libmysqlclient21 \
        libpq5 \
        libsqlite3-0 \
        libuuid1 \
        libvulkan1 \
        mesa-vulkan-drivers \
        libgomp1 \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/shmtu/bin /app/models /app/logs

WORKDIR /app

COPY scripts/docker_download_models.sh /opt/shmtu/bin/docker_download_models.sh
COPY scripts/docker_runtime_entrypoint.sh /opt/shmtu/bin/docker_runtime_entrypoint.sh
COPY docker-runtime/shmtu_cas_ocr_server /opt/shmtu/bin/shmtu_cas_ocr_server
COPY docker-runtime/shmtu_cas_ocr_cli /opt/shmtu/bin/shmtu_cas_ocr_cli

RUN chmod +x /opt/shmtu/bin/docker_download_models.sh /opt/shmtu/bin/docker_runtime_entrypoint.sh

EXPOSE 21600
EXPOSE 21601

ENTRYPOINT ["/opt/shmtu/bin/docker_runtime_entrypoint.sh"]
