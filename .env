# Docker Compose defaults
# Docker Compose only auto-loads .env.
# If you want a machine-local override file, use:
#   docker compose --env-file .env.local up -d

# Published image tag.
# CPU default is latest/latest-cpu; GPU/Vulkan uses the -vulkan suffix.
SHMTU_RUNTIME_IMAGE=a645162/shmtu-cas-ocr-server:latest-vulkan

# Runtime tuning
SHMTU_USE_GPU=1
SHMTU_WORKERS=0
SHMTU_QUEUE_CAPACITY=0
SHMTU_NCNN_THREADS=0

# Model bootstrap source for empty model directories: gitee or github
SHMTU_MODEL_SOURCE=gitee

# Optional metadata shown by /api/health and /api/status
SHMTU_SERVER_NAME=
