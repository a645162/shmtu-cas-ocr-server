{
  "name": "shmtu-cas-ocr-server",
  "version-string": "1.0.0",
  "dependencies": [
    "cli11",
    {
      "name": "opencv4",
      "default-features": false,
      "features": [
        "jpeg",
        "png",
        "tiff",
        "webp"
      ]
    },
    "ncnn",
    "glog",
    "drogon",
    "trantor"
  ],
  "features": {
    "vulkan": {
      "description": "Enable Vulkan support in ncnn.",
      "dependencies": [
        {
          "name": "ncnn",
          "default-features": false,
          "features": [
            "vulkan"
          ]
        }
      ]
    }
  }
}
