FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

ARG USE_CHSRC=0
ARG CHSRC_DEB_URL=https://gitee.com/RubyMetric/chsrc/releases/download/pre/chsrc_latest-1_amd64.deb

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        python3 \
    && rm -rf /var/lib/apt/lists/*

RUN if [ "${USE_CHSRC}" = "1" ]; then \
        curl -fL "${CHSRC_DEB_URL}" -o /tmp/chsrc_latest-1_amd64.deb \
        && dpkg -i /tmp/chsrc_latest-1_amd64.deb \
        && chsrc set ubuntu; \
    fi

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        ninja-build \
        pkg-config \
        unzip \
        libopencv-dev \
        libfmt-dev \
        libdrogon-dev \
        libtrantor-dev \
        libjsoncpp-dev \
        default-libmysqlclient-dev \
        libpq-dev \
        libsqlite3-dev \
        libbrotli-dev \
        libhiredis-dev \
        libssl-dev \
        libcurl4-openssl-dev \
        libvulkan-dev \
        libyaml-cpp-dev \
        uuid-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
